@page "/"
@rendermode InteractiveServer

<div style="display: flex; width: 100%; height: 100vh;">
    <button class="audio-button" disabled 
            onclick="document.getElementById('yesAudio').play()" 
            style="flex: 1; font-size: clamp(2rem, 20vw, 15rem); cursor: pointer; 
                   background-color: #4CAF50; color: white; border: none; font-weight: bold; 
                   display: flex; align-items: center; justify-content: center;">
        YES
    </button>
    <button class="audio-button" disabled 
            onclick="document.getElementById('noAudio').play()" 
            style="flex: 1; font-size: clamp(2rem, 20vw, 15rem); cursor: pointer; 
                   background-color: #f44336; color: white; border: none; font-weight: bold; 
                   display: flex; align-items: center; justify-content: center;">
        NO
    </button>
</div>

<div id="audio-loading" role="status" aria-label="Loading audio" 
     style="position: fixed; inset: 0; z-index: 1000; 
            display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.85);">
    <div style="width: 5rem; height: 5rem; border: 0.6rem solid #e0e0e0; border-top-color: #4CAF50; 
                border-radius: 50%; animation: audio-spin 0.8s linear infinite;"></div>
</div>

<audio id="yesAudio" src="audio/yes.mp3" preload="auto" style="display: none;" 
       oncanplay="onHomeAudioCanPlay()"></audio>
<audio id="noAudio" src="audio/no.mp3" preload="auto" style="display: none;" 
       oncanplay="onHomeAudioCanPlay()"></audio>

<style>
    @@keyframes audio-spin {
        to { transform: rotate(360deg); }
    }
</style>

    
<script>
    function onHomeAudioCanPlay() {
        const audioElements = [
            document.getElementById("yesAudio"),
            document.getElementById("noAudio")
        ];

        if (audioElements.every(audio => audio && audio.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA)) {
            document.getElementById("audio-loading").style.display = "none";
            document.querySelectorAll(".audio-button").forEach(button => button.disabled = false);
        }
    }
</script>